    "test": "node ../../scripts/run-node-tests.mjs",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@takumi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
