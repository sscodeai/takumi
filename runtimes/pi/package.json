{
  "name": "@takumi/runtime-pi",
  "version": "0.1.0",
  "description": "PiRuntimeAdapter: wraps the Pi coding-agent AgentSession into the Takumi AgentRuntimeAdapter contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'dist/test/*.test.js'",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@takumi/core": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
