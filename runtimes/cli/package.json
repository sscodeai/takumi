{
  "name": "@takumi/runtime-cli",
  "version": "0.1.0",
  "description": "CliRuntimeAdapter: bridge to ANY external harness CLI (e.g. DeepSeek Harness `dsh`, Codex) via subprocess, honoring the AgentRuntimeAdapter contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@takumi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sscodeai/takumi.git",
    "directory": "runtimes/cli"
  },
  "homepage": "https://github.com/sscodeai/takumi",
  "bugs": {
    "url": "https://github.com/sscodeai/takumi/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
