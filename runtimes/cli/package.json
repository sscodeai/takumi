{
  "name": "@takumi/runtime-cli",
  "version": "0.1.0",
  "description": "CliRuntimeAdapter: bridge to ANY external harness CLI (e.g. DeepSeek Harness `dsh`, Codex) via subprocess, honoring the AgentRuntimeAdapter contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'dist/test/*.test.js'",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@takumi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}