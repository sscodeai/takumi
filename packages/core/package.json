{
  "name": "@takumi/core",
  "version": "0.1.0",
  "description": "Takumi Core: orchestration primitives, runtime abstraction, extension system. No runtime-specific or Japanese-SI-specific code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'dist/test/*.test.js'",
    "pretest": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}