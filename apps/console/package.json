{
  "name": "@takumi/console",
  "version": "0.1.0",
  "description": "Takumi lightweight web console: run workflows from a browser with live logs (SSE).",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "takumi-console": "./dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@takumi/core": "workspace:*",
    "@takumi/runtime-fake": "workspace:*"
  },  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
